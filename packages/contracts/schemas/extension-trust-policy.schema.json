{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-im-suite.local/schemas/extension-trust-policy.schema.json",
  "title": "ExtensionTrustPolicy",
  "type": "object",
  "required": ["schema", "extensionId", "trustLevel", "capabilities"],
  "properties": {
    "schema": { "const": "codex-im-suite/extension-trust-policy/v1" },
    "extensionId": { "type": "string", "minLength": 1 },
    "trustLevel": { "enum": ["bundled", "trusted", "community", "untrusted"] },
    "sourceUrl": { "type": "string" },
    "sha256": { "type": "string" },
    "signature": { "type": "string" },
    "installedBy": { "type": "string" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "risk", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "enum": ["mcp", "skill", "plugin", "model", "script", "custom"] },
          "risk": { "enum": ["low", "medium", "high"] },
          "description": { "type": "string" },
          "requiresCredential": { "type": "boolean" },
          "credentialScope": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
