{
  "name": "codex-im-suite",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "packages/bridge-core",
    "packages/bridge-runtime",
    "packages/mcp-picture",
    "packages/mcp-unity-prefab",
    "packages/mcp-ignis",
    "apps/control-panel/web"
  ],
  "scripts": {
    "build": "powershell -ExecutionPolicy Bypass -File ./scripts/build-packages.ps1",
    "test:contracts": "npm --workspace @codex-im-suite/contracts test",
    "typecheck:contracts": "npm --workspace @codex-im-suite/contracts run typecheck",
    "test:core": "npm --workspace packages/bridge-core test",
    "test:runtime": "npm --workspace packages/bridge-runtime test",
    "test:boundaries": "node --test scripts/__tests__/dependency-boundaries.test.mjs",
    "check:boundaries": "node scripts/check-dependency-boundaries.mjs",
    "check:human-docs": "node scripts/check-human-documentation.mjs",
    "validate:extensions": "powershell -ExecutionPolicy Bypass -File ./scripts/validate-extension-manifests.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
