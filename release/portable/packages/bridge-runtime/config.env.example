# Claude-to-IM Bridge Configuration
# Copy to ~/.claude-to-im/config.env and edit

# Runtime backend: claude | codex | auto
CTI_RUNTIME=claude

# Enabled channels (comma-separated: telegram,discord,feishu,qq,weixin)
CTI_ENABLED_CHANNELS=telegram

# Default working directory for bridge sessions
CTI_DEFAULT_WORKDIR=/path/to/your/project

# Default model (optional)
# CTI_DEFAULT_MODEL=

# Default mode (code, plan, ask)
CTI_DEFAULT_MODE=code

# Control API for local browser / remote operations console.
# Defaults are local-only. Remote bind requires ALLOW_REMOTE=true and AUTH_TOKEN.
# CTI_CONTROL_API_ENABLED=true
# CTI_CONTROL_API_HOST=127.0.0.1
# CTI_CONTROL_API_PORT=8788
# CTI_CONTROL_API_PUBLIC_BASE_URL=
# CTI_CONTROL_API_AUTH_TOKEN=
# CTI_CONTROL_API_AUTH_ROLE=viewer
# CTI_CONTROL_API_ALLOW_REMOTE=false
# CTI_CONTROL_API_ALLOW_REMOTE_DANGEROUS=false

# Claude CLI path (optional)
# CTI_CLAUDE_CODE_EXECUTABLE=/path/to/claude

# Third-party Anthropic provider (optional)
# ANTHROPIC_API_KEY=your-third-party-api-key
# ANTHROPIC_BASE_URL=https://your-api-provider.com/v1
# ANTHROPIC_AUTH_TOKEN=your-auth-token

# Codex auth (optional if you already ran `codex auth login`)
# CTI_CODEX_API_KEY=
# CTI_CODEX_BASE_URL=
# Explicit Codex model override for bridge runtime. Use this when global
# ~/.codex/config.toml points at a model unsupported by the installed CLI.
# CTI_CODEX_MODEL=gpt-5.4
# CTI_CODEX_SKIP_GIT_REPO_CHECK=true

# Local llama.cpp helper model
# The local model acts as the first-stage routing hub:
# - hybrid: local model routes/compresses first, then upgrades to Codex only when needed
# - local_only: local model answers as much as it safely can, never upgrades to Codex
# - codex_only: bypass local model and send everything to Codex
# CTI_LOCAL_LLM_ENABLED=true
# CTI_LOCAL_LLM_BASE_URL=http://127.0.0.1:8080
# CTI_LOCAL_LLM_MODEL=qwen2.5-coder-7b-instruct
# CTI_LOCAL_LLM_TIMEOUT_MS=45000
# CTI_LOCAL_LLM_AUTO_ROUTE=true
# CTI_LOCAL_LLM_FALLBACK_TO_CODEX=true
# CTI_LOCAL_LLM_ROUTER_ENABLED=true
# CTI_LOCAL_LLM_ROUTER_MODE=hybrid
# CTI_LOCAL_LLM_FORCE_HUB=true
# CTI_LOCAL_LLM_ROUTER_MAX_INPUT_CHARS=6000
# CTI_LOCAL_LLM_ROUTER_MAX_HISTORY_ITEMS=6
# CTI_LOCAL_LLM_ROUTER_TIMEOUT_MS=30000
# CTI_LOCAL_LLM_MAX_INPUT_CHARS=6000
# CTI_LOCAL_LLM_MAX_OUTPUT_TOKENS=768
# CTI_LOCAL_LLM_COMPLEXITY_MODE=conservative

# Telegram
CTI_TG_BOT_TOKEN=your-telegram-bot-token
CTI_TG_CHAT_ID=your-chat-id
# CTI_TG_ALLOWED_USERS=user_id_1,user_id_2
# CTI_TG_OWNER_USERS=user_id_1

# Discord
# CTI_DISCORD_BOT_TOKEN=your-discord-bot-token
# CTI_DISCORD_ALLOWED_USERS=user_id_1,user_id_2
# CTI_DISCORD_OWNER_USERS=user_id_1
# CTI_DISCORD_ALLOWED_CHANNELS=channel_id_1
# CTI_DISCORD_ALLOWED_GUILDS=guild_id_1

# Feishu / Lark
# CTI_FEISHU_APP_ID=your-app-id
# CTI_FEISHU_APP_SECRET=your-app-secret
# CTI_FEISHU_DOMAIN=https://open.feishu.cn
# CTI_FEISHU_ALLOWED_USERS=user_id_1,user_id_2
# CTI_FEISHU_OWNER_USERS=user_id_1

# QQ
# CTI_QQ_APP_ID=your-qq-app-id
# CTI_QQ_APP_SECRET=your-qq-app-secret
# CTI_QQ_ALLOWED_USERS=openid_1,openid_2
# CTI_QQ_OWNER_USERS=openid_1
# CTI_QQ_IMAGE_ENABLED=true
# CTI_QQ_MAX_IMAGE_SIZE=20

# WeChat
# CTI_WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
# CTI_WEIXIN_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
# CTI_WEIXIN_ALLOWED_USERS=user_id_1,user_id_2
# CTI_WEIXIN_OWNER_USERS=user_id_1
# CTI_WEIXIN_MEDIA_ENABLED=false

# Auto-approve tool permission requests without user confirmation
# CTI_AUTO_APPROVE=true

# Oversized artifact delivery
# none: do not auto-upload oversized files, return explicit failure instead
# local_http: copy oversized files into a public directory and return download links
# feishu_docx: upload oversized files into a Feishu docx attachment and return the doc link
# CTI_ARTIFACT_UPLOAD_MODE=feishu_docx
# CTI_FEISHU_DOCX_LINK_SHARE_ENTITY=tenant_readable
# CTI_FEISHU_DOCX_EXTERNAL_ACCESS_ENTITY=closed
#
# CTI_ARTIFACT_UPLOAD_MODE=local_http
# CTI_ARTIFACT_PUBLIC_BASE_URL=https://files.example.com
# CTI_ARTIFACT_PUBLIC_DIR=C:\artifact-publisher\public
# CTI_ARTIFACT_PUBLIC_SUBDIR=bridge-artifacts
