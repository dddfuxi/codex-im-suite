{
  "name": "codex-im-suite",
  "displayName": "Feishu CLI / Codex / MCP Suite",
  "version": "0.2.0",
  "platform": "windows",
  "branches": {
    "stable": "main",
    "integration": "codex/dev",
    "featurePrefix": "codex/"
  },
  "versioning": {
    "scheme": "semver",
    "pre1Policy": "Breaking manifest or config protocol changes bump minor; normal features bump minor; fixes bump patch."
  },
  "extensionProtocol": {
    "version": "1.0.0",
    "id": "extension-manifest/v1",
    "manifestDirs": [
      "./config/mcp.d",
      "./config/skills.d",
      "./config/plugins.d"
    ],
    "requiredFields": [
      "id",
      "displayName",
      "type",
      "version",
      "compatibility",
      "category",
      "optional",
      "installState",
      "source",
      "enabled",
      "description"
    ]
  },
  "runtimeProtocol": {
    "version": "1.0.0",
    "id": "runtime-manifest/v1",
    "requiredFields": [
      "id",
      "displayName",
      "kind",
      "category",
      "enabled",
      "installState",
      "source",
      "cwd",
      "version",
      "description"
    ]
  },
  "packages": {
    "contracts": {
      "path": "./packages/contracts",
      "role": "shared-contracts",
      "buildScript": "npm run build"
    },
    "bridge-core": {
      "path": "./packages/bridge-core",
      "role": "core-library",
      "buildScript": "npm run build"
    },
    "bridge-runtime": {
      "path": "./packages/bridge-runtime",
      "role": "runtime-shell",
      "buildScript": "npm run build"
    },
    "mcp-picture": {
      "path": "./packages/mcp-picture",
      "role": "external-mcp",
      "buildScript": "npm run build"
    },
    "mcp-unity-prefab": {
      "path": "./packages/mcp-unity-prefab",
      "role": "external-mcp",
      "buildScript": "npm run build"
    },
    "mcp-ignis": {
      "path": "./packages/mcp-ignis",
      "role": "external-mcp",
      "buildScript": "npm run build"
    }
  },
  "apps": {
    "control-panel": {
      "path": "./apps/control-panel",
      "role": "desktop-orchestrator"
    },
    "installer": {
      "path": "./apps/installer",
      "role": "windows-installer"
    }
  },
  "config": {
    "mcpManifestDir": "./config/mcp.d",
    "skillManifestDir": "./config/skills.d",
    "pluginManifestDir": "./config/plugins.d",
    "runtimeManifestDir": "./config/runtime.d",
    "localAgentToolManifestDir": "./config/local-agent-tools.d",
    "feishuEmojiCatalogDir": "./config/feishu-emoji.d"
  },
  "extensions": {
    "skills": {
      "sourceDir": "./extensions/skills",
      "manifestDir": "./config/skills.d"
    },
    "plugins": {
      "sourceDir": "./extensions/plugins",
      "manifestDir": "./config/plugins.d"
    },
    "mcps": {
      "manifestDir": "./config/mcp.d"
    }
  },
  "release": {
    "portableDir": "./release/portable",
    "installerDir": "./release/installer",
    "artifactsDir": "./release/artifacts"
  }
}
