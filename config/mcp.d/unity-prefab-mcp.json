{
  "id": "unityPrefabMCP",
  "displayName": "Unity Prefab MCP",
  "type": "stdio",
  "version": "1.0.0",
  "compatibility": {
    "protocol": "extension-manifest/v1",
    "suite": ">=0.2.0 <1.0.0"
  },
  "category": "mcp.game-engine",
  "optional": true,
  "installState": "bundled",
  "installer": "..\\..\\scripts\\install-suite-extension.ps1",
  "source": "${SUITE_ROOT}\\packages\\mcp-unity-prefab",
  "aliases": ["prefab", "prefab mcp", "unity prefab mcp", "预制体 mcp"],
  "enabled": true,
  "launcher": "${SUITE_ROOT}\\scripts\\launch-unity-prefab-mcp.ps1",
  "registerName": "unityPrefabMCP",
  "env": {
    "UNITY_MCP_HOST": "127.0.0.1",
    "UNITY_MCP_HTTP_PORT": "8081",
    "UNITY_MCP_TIMEOUT_MS": "30000"
  },
  "healthCheck": {
    "kind": "codex-mcp-list"
  },
  "description": "Unity prefab folder MCP"
}
