{
  "id": "blenderMCP",
  "displayName": "Blender MCP",
  "type": "stdio",
  "version": "1.0.0",
  "compatibility": {
    "protocol": "extension-manifest/v1",
    "suite": ">=0.2.0 <1.0.0"
  },
  "category": "mcp.creative",
